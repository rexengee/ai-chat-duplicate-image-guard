{
  "manifest_version": 3,
  "name": "AI Chat Duplicate Image Guard",
  "version": "1.1.1",
  "description": "Gemini, ChatGPT ve Claude sohbetlerinde aynı mesaja aynı görselin ikinci kez yapıştırılmasını engeller.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-duplicate-image-guard@ozcanege.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}